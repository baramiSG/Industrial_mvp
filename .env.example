# Optional external reusable build machinery. This repository does not copy it.
FLIGHT_CONTROL_HOME=/path/to/flight-control
UNIVERSAL_NEW_PROJECT_GUIDE=/path/to/Universal-New-Project-Guide.md

# Runtime
IOR_HOST=127.0.0.1
IOR_PORT=8000

# Public acquisition (operator-only; never read by runtime, tests or CI)
IOR_ACQUISITION_LIVE=
IOR_COMTRADE_SUBSCRIPTION_KEY=

# Graph operator variables. Ordinary tests and CI never load Aura values.
IOR_GRAPH_TARGET=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_AUTH_FILE=
AURA_INSTANCEID=
AURA_INSTANCENAME=
